bindings.h after a struct aligned on 8 bytes rather than 16.
--- bindings.h
+++ bindings.h
@@ -19,7 +19,7 @@
 
 // Layouts set by attributes.
 struct __attribute__((packed)) Packed { char tag; int32_t value; };
-struct __attribute__((aligned(16))) Aligned { int32_t value; };
+struct __attribute__((aligned(8))) Aligned { int32_t value; };
 
