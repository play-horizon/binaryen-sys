# Writes one line per item of a bindgen output (src/bindings.rs): its name, a tab, then its text
# on one line, the way scripts/check-c-api.sh compares two releases' bindings. The text keeps the
# item's attributes (`#[repr(C, packed)]`, `#[repr(align(16))]`), its fields and types, the ABI of
# the `extern` block it is declared in, and the `impl` blocks bindgen writes for it (bit-field
# accessors, whose widths they hold; an `impl Trait for Type` block counts as `Type`'s), and leaves
# out what doesn't change the API: documentation, the layout of rustfmt's lines, and the names of
# function parameters. String literals are kept as they are.
#
# It fails, naming the line, on a line it can't read, which a new construct of bindgen's output
# brings: teach it the construct (CONTRIBUTING.md, "When a check fails").
#
# Usage: gawk [--assign=source=<name in messages>] --file=scripts/rust-items.awk src/bindings.rs

# The change in nesting a line brings: its opening brackets minus its closing ones, outside
# string literals.
function depth_change(line,    code) {
	code = line
	gsub(/"([^"\\]|\\.)*"/, "\"\"", code)
	return gsub(/[({[]/, "", code) - gsub(/[)}\]]/, "", code)
}

# `code`, a stretch with no string literal, with rustfmt's layout taken out: one space between
# words, none inside brackets, no trailing comma.
function normalized_code(code) {
	gsub(/[[:space:]]+/, " ", code)
	gsub(/\( /, "(", code)
	gsub(/< /, "<", code)
	gsub(/\[ /, "[", code)
	gsub(/,? ?\)/, ")", code)
	gsub(/,? ?>/, ">", code)
	gsub(/,? ?\]/, "]", code)
	gsub(/,? ?}/, " }", code)
	return code
}

# `text` with the names of the parameters of every function and function pointer in it taken out:
# each `name: ` directly inside the parentheses that follow `fn` or `fn <name>`.
function without_parameter_names(text,    result, rest, depth, character, inside) {
	result = ""
	rest = text
	while (match(rest, /fn( [A-Za-z0-9_]+)?\(/)) {
		result = result substr(rest, 1, RSTART + RLENGTH - 1)
		rest = substr(rest, RSTART + RLENGTH)
		depth = 1
		inside = ""
		while (depth > 0 && rest != "") {
			character = substr(rest, 1, 1)
			if (character == "(") depth++
			else if (character == ")") depth--
			inside = inside character
			rest = substr(rest, 2)
		}
		gsub(/[A-Za-z_][A-Za-z0-9_]*: /, "", inside)
		result = result inside
	}
	return result rest
}

# `text` on one line, its layout normalized and its parameter names taken out, with its string
# literals as they are: each is set aside behind a placeholder (`\001<number>\001`, which holds no
# space, bracket, comma or colon) while the rest is normalized, then put back.
function normalized(text,    literals, literal_count, masked, rest, start, literal_length, number) {
	literal_count = 0
	masked = ""
	rest = text
	while (match(rest, /"([^"\\]|\\.)*"/)) {
		start = RSTART
		literal_length = RLENGTH
		literals[++literal_count] = substr(rest, start, literal_length)
		masked = masked substr(rest, 1, start - 1) "\001" literal_count "\001"
		rest = substr(rest, start + literal_length)
	}
	masked = without_parameter_names(normalized_code(masked rest))
	gsub(/^ | $/, "", masked)
	text = ""
	while (match(masked, /\001[0-9]+\001/)) {
		start = RSTART
		literal_length = RLENGTH
		number = substr(masked, start + 1, literal_length - 2)
		text = text substr(masked, 1, start - 1) literals[number]
		masked = substr(masked, start + literal_length)
	}
	return text masked
}

# The file's name in messages: `source` when the caller sets it (`--assign=source=<name>`).
function file_name() {
	return source != "" ? source : FILENAME
}

function fail(message) {
	print file_name() ":" FNR ": " message > "/dev/stderr"
	failed = 1
	exit 1
}

function finish_item(    text) {
	text = normalized(item_text)
	if (!(item_name in items)) {
		order[++count] = item_name
		items[item_name] = text
	} else {
		items[item_name] = items[item_name] " " text
	}
	item_name = ""
	item_text = ""
}

/^\/\* automatically generated by rust-bindgen/ { next }
/^[[:space:]]*#\[doc = "([^"\\]|\\.)*"\]$/ || /^[[:space:]]*\/\/\// { next }
/^[[:space:]]*#\[doc/ { fail("a documentation attribute on several lines") }
/^[[:space:]]*$/ { next }

item_name == "" && /^unsafe extern "[^"]*" \{$/ {
	block = $0
	sub(/ \{$/, "", block)
	next
}
item_name == "" && block != "" && /^\}$/ { block = ""; next }

item_name == "" && /^[[:space:]]*#\[/ { attributes = attributes " " $0; next }

item_name == "" {
	if (match($0, /^[[:space:]]*impl(<[^>]*>)? ([A-Za-z0-9_:]+(<[^>]*>)? for )?[A-Za-z0-9_]+/)) {
		name = substr($0, RSTART, RLENGTH)
		sub(/.* /, "", name)
	} else if (match($0, /^[[:space:]]*pub (unsafe )?(struct|union|enum|type|const|static mut|static|fn) [A-Za-z0-9_]+/)) {
		name = substr($0, RSTART, RLENGTH)
		sub(/.* /, "", name)
	} else {
		fail("a line it can't read: " $0)
	}
	item_name = name
	item_text = (block != "" ? block " " : "") attributes " " $0
	attributes = ""
	depth = depth_change($0)
	if (depth == 0 && $0 ~ /[;}][[:space:]]*$/) {
		finish_item()
	}
	next
}

{
	item_text = item_text " " $0
	depth += depth_change($0)
	if (depth == 0 && $0 ~ /[;}][[:space:]]*$/) {
		finish_item()
	}
}

END {
	if (failed) {
		exit 1
	}
	if (item_name != "" || attributes != "" || block != "") {
		print file_name() ": the file ends inside an item" > "/dev/stderr"
		exit 1
	}
	for (i = 1; i <= count; i++) {
		print order[i] "\t" items[order[i]]
	}
}
